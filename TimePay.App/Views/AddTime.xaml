<Page x:Class="TimePay.App.Views.AddTime"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Computer Time"
      Background="{StaticResource PrimaryBgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <Button x:Name="BackBtn" Content="← BACK"
                    Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Left"
                    Padding="16,8"
                    Click="BackBtn_Click"/>
            <StackPanel Margin="16,0,0,0">
                <TextBlock Text="ADD COMPUTER TIME" Style="{StaticResource PageTitle}" FontSize="22"/>
                <TextBlock Text="Convert monetary payment into computer usage time" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardPanel}" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    MinWidth="480" MaxWidth="540">
                <StackPanel>
                    <!-- Current Balance & Rate summary card -->
                    <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Current Balance -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="CURRENT BALANCE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CurrentBalanceText" Text="00:00:00"
                                           FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Separator Grid.Column="1" Background="#2e3859" Margin="12,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Width="1"/>

                            <!-- Active Rate -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="CURRENT RATE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CurrentRateText" Text="₱1 = 4 min"
                                           FontFamily="{StaticResource PrimaryFont}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Amount Input -->
                    <TextBlock Text="Amount Received" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource SecondaryBgBrush}" 
                                BorderBrush="#2a3555" BorderThickness="1,1,0,1" 
                                CornerRadius="8,0,0,8" Padding="16,12">
                            <TextBlock x:Name="CurrencySymbolPrefix" Text="₱" 
                                       FontSize="16" FontWeight="Bold" 
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </Border>

                        <TextBox x:Name="AmountInputBox" 
                                 Grid.Column="1"
                                 Style="{StaticResource DarkTextBox}"
                                 FontSize="18" FontWeight="Bold"
                                 FontFamily="{StaticResource MonoFont}"
                                 Text="20"
                                 BorderThickness="0,1,1,1"
                                 Padding="12,10"
                                 TextChanged="AmountInputBox_TextChanged"
                                 KeyDown="AmountInputBox_KeyDown"/>
                    </Grid>

                    <!-- Quick Amount Preset Buttons -->
                    <TextBlock Text="Quick Presets" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,20">
                        <Button Content="+ ₱5" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,8" Click="PresetButton_Click" Tag="5"/>
                        <Button Content="+ ₱10" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,8" Click="PresetButton_Click" Tag="10"/>
                        <Button Content="+ ₱20" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,8" Click="PresetButton_Click" Tag="20"/>
                        <Button Content="+ ₱50" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,8" Click="PresetButton_Click" Tag="50"/>
                        <Button Content="+ ₱100" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,8" Click="PresetButton_Click" Tag="100"/>
                        <Button Content="+ ₱200" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,8" Click="PresetButton_Click" Tag="200"/>
                    </WrapPanel>

                    <!-- Live Conversion Preview Box -->
                    <Border Background="{StaticResource InputBgBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,20" BorderBrush="#2e3859" BorderThickness="1">
                        <StackPanel>
                            <!-- Time to Add -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Time To Add:" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="TimeToAddText" Text="+ 01:20:00 (80 mins)" 
                                           FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" 
                                           Foreground="{StaticResource ActiveBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Separator Background="#2a3555" Margin="0,4,0,8"/>

                            <!-- New Balance -->
                            <DockPanel>
                                <TextBlock Text="New Projected Balance:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="NewBalanceText" Text="01:20:00" 
                                           FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Error Text -->
                    <TextBlock x:Name="ErrorText" 
                               Style="{StaticResource ErrorText}" 
                               Visibility="Collapsed" 
                               Margin="0,0,0,16"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="CancelBtn" 
                                Grid.Column="0" 
                                Content="CANCEL" 
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="BackBtn_Click"/>

                        <Button x:Name="ConfirmAddTimeBtn" 
                                Grid.Column="2" 
                                Content="ADD TIME" 
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="ConfirmAddTimeBtn_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
