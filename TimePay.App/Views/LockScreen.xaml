<Page x:Class="TimePay.App.Views.LockScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TimePay - PC Locked"
      Background="{StaticResource LockBgBrush}">
    <Grid>
        <!-- Background subtle glow decoration -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="600" Height="600" CornerRadius="300"
                Background="#10ff4757" Margin="0,0,0,0" IsHitTestVisible="False"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource CardPanel}"
                    Background="#16182e"
                    BorderBrush="#3d1f2b"
                    BorderThickness="1.5"
                    MinWidth="480" MaxWidth="520"
                    Margin="24">
                <StackPanel>
                    <!-- Lock Icon & Title -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border Width="64" Height="64" CornerRadius="14" Margin="0,0,0,12" HorizontalAlignment="Center"
                                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1.5">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                            </Border.Clip>
                            <Image Source="/Assets/app.png" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="TIMEPAY" Style="{StaticResource PageTitle}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock x:Name="LockTitleText" Text="COMPUTER TIME EXPIRED"
                                   FontFamily="{StaticResource PrimaryFont}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Big Zero Countdown -->
                    <Border Background="{StaticResource InputBgBrush}" CornerRadius="10" Padding="16,10" Margin="0,0,0,18" BorderBrush="#2e3859" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TIME REMAINING" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="00:00:00" FontFamily="{StaticResource MonoFont}"
                                       FontSize="46" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Notice message -->
                    <TextBlock x:Name="LockMessageText" 
                               Text="Your purchased computer time has ended. Please contact the administrator or counter to add more time."
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"
                               Margin="0,0,0,16"/>

                    <!-- Rate Banner -->
                    <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Current Pricing Rate: " FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="CurrentRateBadge" Text="₱1 = 4 minutes" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Toggle Admin Panel Button (if panel hidden) -->
                    <Button x:Name="ShowAdminLoginBtn" 
                            Content="🔑 ADMIN LOGIN / ADD TIME" 
                            Style="{StaticResource PrimaryButton}"
                            Background="{StaticResource AdminBrush}"
                            HorizontalAlignment="Stretch"
                            Click="ShowAdminLoginBtn_Click"
                            Margin="0,0,0,0"/>

                    <!-- Inline Admin Login Form (Revealed on click) -->
                    <Border x:Name="AdminLoginFormPanel" 
                            Background="{StaticResource InputBgBrush}" 
                            CornerRadius="10" Padding="20" Margin="0,16,0,0" 
                            BorderBrush="#433066" BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="ADMINISTRATOR AUTHENTICATION" 
                                           FontFamily="{StaticResource PrimaryFont}" FontSize="12" FontWeight="Bold" 
                                           Foreground="{StaticResource AdminBrush}" VerticalAlignment="Center"/>
                                <Button Content="✕" 
                                        Background="Transparent" Foreground="{StaticResource MutedTextBrush}" 
                                        BorderThickness="0" Cursor="Hand" FontSize="14"
                                        DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Click="CloseAdminLoginBtn_Click"/>
                            </DockPanel>

                            <!-- Username -->
                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AdminUsernameBox" 
                                     Style="{StaticResource DarkTextBox}" 
                                     Margin="0,0,0,12"
                                     KeyDown="AdminInput_KeyDown"/>

                            <!-- Password -->
                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="AdminPasswordBox" 
                                         Style="{StaticResource DarkPasswordBox}" 
                                         Margin="0,0,0,12"
                                         KeyDown="AdminInput_KeyDown"/>

                            <!-- Error Message -->
                            <TextBlock x:Name="ErrorText" 
                                       Style="{StaticResource ErrorText}" 
                                       Visibility="Collapsed" 
                                       Margin="0,0,0,12"/>

                            <!-- Login Actions -->
                            <Button x:Name="AdminUnlockBtn" 
                                    Content="AUTHENTICATE &amp; UNLOCK" 
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource AdminBrush}"
                                    HorizontalAlignment="Stretch"
                                    Click="AdminUnlockBtn_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
