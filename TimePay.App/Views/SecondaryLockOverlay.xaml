<Window x:Class="TimePay.App.Views.SecondaryLockOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimePay - PC Locked"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0d0e1a"
        WindowStartupLocation="Manual">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="16" Margin="0,0,0,16" HorizontalAlignment="Center"
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="2">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,72,72" RadiusX="16" RadiusY="16"/>
                </Border.Clip>
                <Image Source="/Assets/app.png" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="TIMEPAY" Style="{StaticResource PageTitle}" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="COMPUTER TIME EXPIRED"
                       FontFamily="{StaticResource PrimaryFont}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Please purchase or add computer time on the primary display to unlock this screen."
                       FontFamily="{StaticResource PrimaryFont}" FontSize="14"
                       Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
