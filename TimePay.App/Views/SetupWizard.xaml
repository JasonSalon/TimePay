<Page x:Class="TimePay.App.Views.SetupWizard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Setup Wizard"
      Background="{StaticResource PrimaryBgBrush}">
    <Grid>
        <Border Style="{StaticResource CardPanel}" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                MinWidth="460" MaxWidth="520">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="TIMEPAY" 
                           Style="{StaticResource PageTitle}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Welcome! Let's configure your computer."
                           Style="{StaticResource PageSubtitle}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- Currency -->
                <TextBlock Text="Currency" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CurrencyCombo" 
                          Margin="0,0,0,18" Padding="14,12"
                          FontSize="15" FontFamily="{StaticResource PrimaryFont}"
                          SelectedIndex="0">
                    <ComboBoxItem Content="₱ Philippine Peso (PHP)"/>
                    <ComboBoxItem Content="$ US Dollar (USD)"/>
                    <ComboBoxItem Content="€ Euro (EUR)"/>
                    <ComboBoxItem Content="¥ Japanese Yen (JPY)"/>
                    <ComboBoxItem Content="S$ Singapore Dollar (SGD)"/>
                    <ComboBoxItem Content="RM Malaysian Ringgit (MYR)"/>
                </ComboBox>

                <!-- Minutes Per Peso -->
                <TextBlock Text="Minutes per unit of currency" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="MinutesPerPesoBox" 
                         Style="{StaticResource DarkTextBox}"
                         Text="4" Margin="0,0,0,18"/>

                <!-- Separator -->
                <Separator Background="#2a3555" Margin="0,4,0,18"/>

                <!-- Admin Username -->
                <TextBlock Text="Admin Username" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UsernameBox" 
                         Style="{StaticResource DarkTextBox}"
                         Text="admin" Margin="0,0,0,18"/>

                <!-- Admin Password -->
                <TextBlock Text="Admin Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" 
                             Style="{StaticResource DarkPasswordBox}"
                             Margin="0,0,0,18"/>

                <!-- Confirm Password -->
                <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" 
                             Style="{StaticResource DarkPasswordBox}"
                             Margin="0,0,0,18"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText" 
                           Style="{StaticResource ErrorText}"
                           Visibility="Collapsed"
                           Margin="0,0,0,12"/>

                <!-- Submit -->
                <Button x:Name="CompleteSetupBtn"
                        Content="COMPLETE SETUP"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="CompleteSetupBtn_Click"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
