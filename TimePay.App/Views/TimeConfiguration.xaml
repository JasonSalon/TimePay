<Page x:Class="TimePay.App.Views.TimeConfiguration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Time Configuration"
      Background="{StaticResource PrimaryBgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <Button x:Name="BackBtn" Content="← BACK"
                    Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Left"
                    Padding="16,8"
                    Click="BackBtn_Click"/>
            <StackPanel Margin="16,0,0,0">
                <TextBlock Text="TIME CONFIGURATION" Style="{StaticResource PageTitle}" FontSize="22"/>
                <TextBlock Text="Configure pricing rates and currency settings" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid HorizontalAlignment="Center" MaxWidth="720" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Settings Form -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="RATE SETTINGS" 
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Currency Selector -->
                        <TextBlock Text="Currency" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CurrencyCombo" 
                                  Margin="0,0,0,20" Padding="12,10"
                                  FontSize="14" FontFamily="{StaticResource PrimaryFont}"
                                  SelectionChanged="CurrencyCombo_SelectionChanged">
                            <ComboBoxItem Content="₱ Philippine Peso (PHP)"/>
                            <ComboBoxItem Content="$ US Dollar (USD)"/>
                            <ComboBoxItem Content="€ Euro (EUR)"/>
                            <ComboBoxItem Content="¥ Japanese Yen (JPY)"/>
                            <ComboBoxItem Content="S$ Singapore Dollar (SGD)"/>
                            <ComboBoxItem Content="RM Malaysian Ringgit (MYR)"/>
                        </ComboBox>

                        <!-- Minutes per Peso -->
                        <TextBlock Text="Minutes per Currency Unit" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MinutesPerPesoBox" 
                                 Style="{StaticResource DarkTextBox}"
                                 Text="4"
                                 Margin="0,0,0,8"
                                 TextChanged="MinutesPerPesoBox_TextChanged"/>
                        <TextBlock Text="Example: Enter 4 for 4 minutes per ₱1"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Current Configured Rate -->
                        <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Current Active Rate" 
                                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="CurrentRateBadge" Text="₱1 = 4 minutes"
                                           FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Error display -->
                        <TextBlock x:Name="ErrorText" 
                                   Style="{StaticResource ErrorText}"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,16"/>

                        <!-- Save Button -->
                        <Button x:Name="SaveBtn" Content="SAVE SETTINGS"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="SaveBtn_Click"/>
                    </StackPanel>
                </Border>

                <!-- Right Column: Live Calculations Preview -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="LIVE RATE PREVIEW" 
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Instant Update" 
                                       FontSize="11" Foreground="{StaticResource ActiveBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Calculations based on current input:"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- Preview Table Items -->
                        <Border Background="{StaticResource InputBgBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,0,16">
                            <StackPanel x:Name="PreviewItemsPanel">
                                <!-- Populated dynamically in code-behind -->
                            </StackPanel>
                        </Border>

                        <Border Background="#1f2438" CornerRadius="8" Padding="12" BorderBrush="#2e3859" BorderThickness="1">
                            <TextBlock Text="ℹ️ Changing the pricing rate will only affect future time purchases. Existing active user sessions and previous transactions remain unchanged."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       LineHeight="16"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
