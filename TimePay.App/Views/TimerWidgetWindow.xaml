<Window x:Class="TimePay.App.Views.TimerWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimePay HUD" 
        Height="36" Width="136"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False"
        Focusable="False"
        Opacity="0.65">
    <!-- Subtle frosted dark HUD pill -->
    <Border Background="#660a0f1d" 
            BorderBrush="#334fc3f7" 
            BorderThickness="1" 
            CornerRadius="10" 
            Padding="10,4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Subtle Status Dot -->
            <Ellipse x:Name="StatusDot" 
                     DockPanel.Dock="Left" 
                     Width="7" Height="7" 
                     Fill="#00d97e" 
                     Margin="0,0,8,0" 
                     VerticalAlignment="Center"/>

            <!-- Remaining Time Display (Clean monospaced text) -->
            <TextBlock x:Name="WidgetTimeText" 
                       Text="00:00:00" 
                       FontFamily="Consolas, monospace" 
                       FontSize="15" 
                       FontWeight="Bold" 
                       Foreground="#ffffff" 
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="#000000"/>
                </TextBlock.Effect>
            </TextBlock>
        </DockPanel>
    </Border>
</Window>
