<Page x:Class="TimePay.App.Views.UserDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TimePay - User Dashboard"
      Background="{StaticResource PrimaryBgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="TIMEPAY" Style="{StaticResource PageTitle}" FontSize="24" Margin="0,0,16,0"/>
                <Border x:Name="StatusBadge" Background="#16382b" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="● ACTIVE" 
                               FontFamily="{StaticResource PrimaryFont}" FontSize="12" FontWeight="Bold" 
                               Foreground="{StaticResource ActiveBrush}"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="MiniWidgetBtn" Content="◰ MINI WIDGET"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,8" Margin="0,0,12,0"
                        Click="MiniWidgetBtn_Click"/>

                <Button x:Name="AdminLoginBtn" Content="🔑 ADMIN LOGIN"
                        Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource AdminBrush}"
                        Padding="16,8"
                        Click="AdminLoginBtn_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Center Content Card -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="480" MaxWidth="540">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <!-- Low Time Warning Banner (Dynamic) -->
                        <Border x:Name="WarningBanner" 
                                Background="#3d2c0b" 
                                BorderBrush="{StaticResource WarningBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="14,10" 
                                Margin="0,0,0,20"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WarningBannerText" 
                                           Text="LOW TIME WARNING: Please save your work!" 
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="13" FontWeight="SemiBold" 
                                           Foreground="{StaticResource WarningBrush}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Time Remaining Section -->
                        <TextBlock Text="TIME REMAINING"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>

                        <TextBlock x:Name="TimerDisplay" 
                                   Text="00:00:00"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="56" FontWeight="Bold"
                                   Foreground="{StaticResource ActiveBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <!-- Expiration Time & Rate Pill -->
                        <Border Background="{StaticResource SecondaryBgBrush}" 
                                CornerRadius="8" 
                                Padding="16,10" 
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Expires At -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="EXPIRES AT" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ExpiresAtText" Text="--:-- --" 
                                               FontFamily="{StaticResource PrimaryFont}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Separator Grid.Column="1" Background="#2a3555" Margin="10,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Width="1"/>

                                <!-- Rate -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="CURRENT RATE" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CurrentRateText" Text="₱1 = 4 min" 
                                               FontFamily="{StaticResource PrimaryFont}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Guidance Notice -->
                        <TextBlock Text="💡 Tip: Always save your active documents and game progress regularly."
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="TimePay v1.0 • Secure PC Time Management" 
                       FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                       DockPanel.Dock="Left"/>
            <TextBlock x:Name="SessionIdText" Text="Session: --" 
                       FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                       DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Page>
